{
  "name": "bible-link",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "postbuild:web": "node scripts/createWordPage.js",
    "merge:lib1": "node scripts/mergeLib1.js",
    "validate:maps": "node scripts/mergeLib1.js && node scripts/validateMaps.js",
    "generate:map": "node scripts/mergeLib1.js && node scripts/generateMap.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.0",
    "expo-font": "~14.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  }
}
