rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 출제 단어: 읽기만 가능
    match /dailyWords/{date} {
      allow read: if true;
      allow write: if false; // GitHub Actions 서비스 계정만
    }

    // 챌린지 출제 단어: 읽기만 가능
    match /challengeWords/{date} {
      allow read: if true;
      allow write: if false; // GitHub Actions 서비스 계정만
    }

    // 랭킹: 읽기 허용, 신규 등록은 서버 기준 오늘(KST 23시 경계)의 day 값만 허용
    match /rankings/{docId} {
      allow read: if true;
      allow create: if request.resource.data.day == math.floor((request.time.toMillis() + 36000000) / 86400000);
      allow update, delete: if false; // 수정/삭제 불가
    }

    // 챌린지 랭킹: rankings와 동일 규칙
    match /challengeRankings/{docId} {
      allow read: if true;
      allow create: if request.resource.data.day == math.floor((request.time.toMillis() + 36000000) / 86400000);
      allow update, delete: if false; // 수정/삭제 불가
    }

    match /headsUpWordUsage/{dateKey}/words/{wordId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['dateKey', 'day', 'wordId', 'category', 'popularity', 'calledAt'])
        && request.resource.data.keys().hasAll(['dateKey', 'day', 'wordId', 'category', 'popularity', 'calledAt'])
        && request.resource.data.dateKey == dateKey
        && request.resource.data.day == math.floor((request.time.toMillis() + 32400000) / 86400000)
        && request.resource.data.wordId == wordId
        && request.resource.data.category in ['인물', '지명']
        && request.resource.data.popularity is int
        && request.resource.data.popularity >= 1
        && request.resource.data.popularity <= 3
        && request.resource.data.calledAt == request.time;
      allow update, delete: if false;
    }

    // 서버 시간 확인용 ping: 생성만 허용, 미래 시각 위조 차단
    match /timePings/{docId} {
      allow read: if true;
      allow create: if request.resource.data.t <= request.time;
      allow update, delete: if false;
    }
  }
}
